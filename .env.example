# 本文件只定义变量名，不填写真实凭证。复制为 .env 后在本地填写。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# LLM provider: disabled | deepseek。默认禁用，不需要真实凭证。
LLM_PROVIDER=disabled
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
LLM_MAX_CONCURRENCY=2
LLM_IDEMPOTENCY_TTL_SECONDS=600
LLM_IDEMPOTENCY_MAX_ENTRIES=256
LLM_THINKING_ENABLED=false
LLM_STREAM=false

# 仅在后续获批准启用向量检索时配置；首个切片不需要。
QDRANT_URL=
QDRANT_API_KEY=
