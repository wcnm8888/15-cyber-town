# 本文件只定义变量名，不填写真实凭证。复制为 .env 后在本地填写。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# LLM provider: deepseek | mock (仅测试替身，不可当作真实能力验收)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# 仅在后续获批准启用向量检索时配置；首个切片不需要。
QDRANT_URL=
QDRANT_API_KEY=
